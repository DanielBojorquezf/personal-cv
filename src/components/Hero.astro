---
import { getLangFromUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/translations';
import HeroTerminal from './HeroTerminal.astro';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const cvHref = lang === 'es' ? '/cv/daniel-bojorquez-es.pdf' : '/cv/daniel-bojorquez.pdf';
---
<section id="hero">
  <div class="hero-container" data-aos="fade-in">
    <p class="hero-eyebrow">{t.hero.eyebrow}</p>
    <h1>{t.hero.title}</h1>
    <p class="hero-line">{t.hero.line}</p>
    <div class="hero-actions">
      <a class="hero-btn" href="#work">{t.hero.ctaWork}</a>
      <a class="hero-btn hero-btn-ghost" href={cvHref} download>{t.cv.download}</a>
    </div>
    <ul class="hero-tags">
      {t.hero.tags.map((tag) => <li>{tag}</li>)}
    </ul>
  </div>
  <HeroTerminal />
</section>
