---
import { getLangFromUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/translations';

const t = useTranslations(getLangFromUrl(Astro.url));
---
<section id="resume" class="resume">
  <div class="container">
    <div class="section-title">
      <h2>{t.resume.title}</h2>
    </div>
    <div class="row">
      <div class="col-lg-6" data-aos="fade-up">
        <h3 class="resume-title">{t.resume.summary}</h3>
        <div class="resume-item pb-0">
          <h4>Daniel Bojorquez</h4>
          <p><em>{t.resume.summaryText}</em></p>
          <ul>
            <li>Hermosillo, Sonora, México</li>
            <li>(662) 297-1219</li>
            <li>danielbojorquezf@gmail.com</li>
          </ul>
        </div>
        <h3 class="resume-title">{t.resume.education}</h3>
        <div class="resume-item">
          <h4>{t.resume.edu1Title}</h4>
          <h5>{t.resume.edu1Date}</h5>
          <p><em>{t.resume.edu1School}</em></p>
          <p>{t.resume.edu1Body}</p>
        </div>
        <div class="resume-item">
          <h4>{t.resume.edu2Title}</h4>
          <h5>{t.resume.edu2Date}</h5>
          <p><em>{t.resume.edu2School}</em></p>
          <p>{t.resume.edu2Body}</p>
        </div>
      </div>
      <div class="col-lg-6" data-aos="fade-up" data-aos-delay="100">
        <h3 class="resume-title">{t.resume.experience}</h3>
        <div class="resume-item">
          <h4>{t.resume.job1Title}</h4>
          <h5>{t.resume.job1Date}</h5>
          <p><em>{t.resume.job1Company}</em></p>
          <ul>
            {t.resume.job1Items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="resume-item">
          <h4>{t.resume.job2Title}</h4>
          <h5>{t.resume.job2Date}</h5>
          <p><em>{t.resume.job2Company}</em></p>
          <ul>
            {t.resume.job2Items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
        <div class="resume-item">
          <h4>{t.resume.job3Title}</h4>
          <h5>{t.resume.job3Date}</h5>
          <p><em>{t.resume.job3Company}</em></p>
          <ul>
            {t.resume.job3Items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </div>
    </div>
  </div>
</section>
