---
import { getLangFromUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/translations';

const t = useTranslations(getLangFromUrl(Astro.url));
---
<section id="about" class="about">
  <div class="container">
    <div class="section-title">
      <h2>{t.about.title}</h2>
      <p>{t.about.body}</p>
    </div>
    <div class="row">
      <div class="col-lg-4" data-aos="fade-right">
        <img src="/assets/img/profile-img.jpg" class="img-fluid" alt="Daniel Bojorquez">
      </div>
      <div class="col-lg-8 pt-4 pt-lg-0 content" data-aos="fade-left">
        <h3>{t.about.role}.</h3>
        <p class="fst-italic">{t.about.italic}</p>
        <div class="row">
          <div class="col-lg-6">
            <ul>
              <li><i class="bi bi-chevron-right"></i> <strong>{t.about.phone}:</strong> <span><a href="tel:+526622971219">+52 (662) 297-1219</a></span></li>
              <li><i class="bi bi-chevron-right"></i> <strong>{t.about.email}:</strong> <span><a href="mailto:danielbojorquezf@gmail.com">danielbojorquezf@gmail.com</a></span></li>
            </ul>
          </div>
          <div class="col-lg-6">
            <ul>
              <li><i class="bi bi-chevron-right"></i> <strong>{t.about.city}:</strong> <span>{t.about.cityValue}</span></li>
              <li><i class="bi bi-chevron-right"></i> <strong>{t.about.freelance}:</strong> <span>{t.about.freelanceValue}</span></li>
            </ul>
          </div>
          <div class="col-lg-12">
            <ul>
              <li><i class="bi bi-chevron-right"></i> <strong>{t.about.degree}:</strong> <span>{t.about.degreeValue}</span></li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
