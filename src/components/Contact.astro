---
import { getLangFromUrl } from '../i18n/utils';
import { useTranslations } from '../i18n/translations';

const t = useTranslations(getLangFromUrl(Astro.url));
---
<section id="contact" class="contact">
  <div class="container">
    <div class="section-title">
      <h2>{t.contact.title}</h2>
      <p>{t.contact.body}</p>
    </div>
    <div class="row" data-aos="fade-in">
      <div class="col-lg-5 d-flex align-items-stretch">
        <div class="info">
          <div class="address">
            <i class="bi bi-geo-alt"></i>
            <h4>{t.contact.location}:</h4>
            <p>{t.contact.locationValue}</p>
          </div>
          <div class="email">
            <i class="bi bi-envelope"></i>
            <h4>{t.contact.email}:</h4>
            <p>danielbojorquzf@gmail.com</p>
          </div>
          <div class="phone">
            <i class="bi bi-phone"></i>
            <h4>{t.contact.call}:</h4>
            <p>+52 (662) 297-1219</p>
          </div>
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d111569.88827373156!2d-111.00033357812836!3d29.08917364168091!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x86ce84687adfaee5%3A0xb33d5395e9887ff9!2sHermosillo%2C%20Son.!5e0!3m2!1ses!2smx!4v1720924547573!5m2!1ses!2smx"
            title="Hermosillo, Sonora"
            style="border:0; width: 100%; height: 290px;"
            allowfullscreen></iframe>
        </div>
      </div>
      <div class="col-lg-7 mt-5 mt-lg-0 d-flex align-items-stretch">
        <form action="forms/contact.php" method="post" role="form" class="php-email-form">
          <div class="row">
            <div class="form-group col-md-6">
              <label for="name">{t.contact.name}</label>
              <input type="text" name="name" class="form-control" id="name" required />
            </div>
            <div class="form-group col-md-6">
              <label for="email">{t.contact.yourEmail}</label>
              <input type="email" class="form-control" name="email" id="email" required />
            </div>
          </div>
          <div class="form-group">
            <label for="subject">{t.contact.subject}</label>
            <input type="text" class="form-control" name="subject" id="subject" required />
          </div>
          <div class="form-group">
            <label for="message">{t.contact.message}</label>
            <textarea class="form-control" name="message" id="message" rows="10" required></textarea>
          </div>
          <div class="my-3">
            <div class="loading">{t.contact.loading}</div>
            <div class="error-message"></div>
            <div class="sent-message">{t.contact.sent}</div>
          </div>
          <div class="text-center">
            <button type="submit">{t.contact.send}</button>
          </div>
        </form>
      </div>
    </div>
  </div>
</section>
